    <div class="w-full grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5  gap-5 border-t border-gray-200 py-10 ">
        <!-- Logo Section -->
        <div class="flex items-start gap-2 justify-center sm:justify-start">
            <Icon name="logo" size={30} class={"text-center"}/>
            <span class="text-indigo-600 font-semibold mt-1 text-center">Boolean Maths</span>
        </div>
        
        <!-- Useful Links -->
        <div>
            <h3 class="font-semibold text-gray-800 mb-4 text-center">Useful Links</h3>
            <ul class="space-y-2 text-sm text-center">
                <li><a href="#" class="text-gray-600 hover:text-indigo-600 transition duration-300">Home</a></li>
                <li><a href="#" class="text-gray-600 hover:text-indigo-600 transition duration-300">Product</a></li>
                <li><a href="#" class="text-gray-600 hover:text-indigo-600 transition duration-300">Solution</a></li>
                <li><a href="#" class="text-gray-600 hover:text-indigo-600 transition duration-300">Privacy policy</a></li>
