---
import Layout from "../layouts/Layout.astro";
const { post } = Astro.props;
---
<div class="card rounded-xl overflow-hidden border bg-white shadow-xl transition-transform duration-500 hover:-translate-y-1 hover:scale-105">
  <a href={`/post/${post.slug}`} class="block">
    {/* Large Image */}
    <figure class="w-full">
      <img
        class="w-full h-64 object-cover"
        src={post.mainImage}
        alt={post.alt}
      />
    </figure>

    {/* Content Section */}
    <div class="p-5">
      {/* Tags */}
      <div class="flex flex-wrap gap-2 text-xs mb-2">
        {post.tags?.map((tag, index) => (
          <span key={index} class="badge badge-outline border border-black px-3 py-1">
            {tag}
          </span>
        ))}
      </div>

      {/* Date */}
      <p class="text-xs text-gray-500">{post.publishedAt}</p>

      {/* Title */}
      <h3 class="text-lg font-semibold">{post.title}</h3>
    </div>
  </a>
</div>
