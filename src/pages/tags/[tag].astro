import { sanityClient } from "sanity:client";
import { slugify } from "../../lib/Slugify"; // Ensure you have your slugify helper here
// import type { SanityDocument } from "@sanity/client";

// Generate static paths based on authors' names slugified
export async function getStaticPaths() {
  // Fetch all authors (only the name is needed to generate the slug)
  const authors = await sanityClient.fetch(`*[_type == "author"]{ name }`);
  return authors.map((author: { name: string }) => ({
    params: { slug: slugify(author.name) },
  }));
}

