---
// import { sanityClient } from "sanity:client";
import Layout from "../../layouts/Layout.astro";
import { loadQuery } from "../../lib/load-query";
import type { SanityDocument } from "@sanity/client";
// import { date } from "astro:schema";
import PortableText from "../../components/PortableText.astro";


export async function getStaticPaths() {
    const { data: posts } = await loadQuery<SanityDocument[]>({
    query: `*[_type == "post"]`,
  });
  return posts.map(({ slug }) => {
    return {
      params: {
        slug: slug.current,
      },
    };
  });
}

const { params } = Astro;
// const { slug } = Astro.params;

const querypost = `*[_type == 'post' && slug.current == $slug][0]{
  title,
  "slug": slug.current,
  "mainImage": coalesce(mainImage.asset->url, ""),
  author,
  body,publishedAt,
  tags
}`;

const { data: post } = await loadQuery({
  query: querypost,
  params,
});

// const singlePost = await sanityClient.fetch(query, { slug });

console.log("Fetched Post Data:", post);
---

<Layout>
  

    <main>
      <article class="prose mx-auto">
        {
          post && (
            <>
                <div class="prose-h1 text-center">
                  <h1>{post.title}</h1>
                </div>
    
                {post.mainImage && (
                  <div>
                    <img
                      class="h-[30%] w-full"
                      src={`${post.mainImage}`}
                      alt={post.title}
                    />
                  </div>
                )}
    
                <div class="mb-3 mt-4 flex justify-between">
                  {/* <small>
                    Publish on <FormattedDate date={post.publishedAt} />
                    ，Update on <FormattedDate date={new Date().toISOString()} />
                  </small> */}
                </div>
                {post.tags &&
                  post.tags.map((tag) => (
                    <span class="m-1 gap-5 rounded-full bg-blue-400 p-2 text-white">
                      {tag}
                    </span>
                  ))}
    
                <div>
                  <PortableText portableText={post.body} />
                </div>
              </>
            )
          }
        </article>
      </main>
  
</Layout>