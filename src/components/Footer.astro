                <li><a href="#" class="text-gray-600 hover:text-indigo-600 transition duration-300">YT Video 1</a></li>
                <li><a href="#" class="text-gray-600 hover:text-indigo-600 transition duration-300">YT Video 2</a></li>
            </ul>
        </div>
        
        <!-- Contact Us -->
        <div class="text-center">
            <h3 class="font-semibold text-gray-800 mb-4">Contact Us</h3>
            <p class="text-gray-600 mb-2 text-sm">contact@medront.com</p>
            <p class="text-gray-600 mb-2 text-sm">(+91) 87892 75900</p>
            <p class="text-gray-600 text-sm">
