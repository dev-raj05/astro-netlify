---
import { sanityClient } from "sanity:client";
import { slugify } from "../../lib/Slugify";

const posts = await sanityClient.fetch(`*[_type == "post"]{ "categories": categories[]->name }`);

// Extract unique categories and slugify them
const allCategories = [...new Set(posts.flatMap(post => post.categories || []))].map(slugify);

// Generate static paths for each unique category
export async function getStaticPaths() {
  return allCategories.map(category => ({
    params: { category },
  }));
}

// Get category from URL
const { category } = Astro.params;

const filteredPosts = await sanityClient.fetch(
  `*[_type == "post" && $category in categories[]->name]{
    title,
    slug,
    mainImage,
    "categories": categories[]->name
  }`,
  { category }
);
---