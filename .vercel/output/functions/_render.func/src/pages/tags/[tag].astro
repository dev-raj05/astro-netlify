---
import { sanityClient } from "sanity:client";
import Layout from "../../layouts/Layout.astro";
import Card from "../../components/Card.astro";

const posts = await sanityClient.fetch(`*[_type == "post"]{
  "tags": tags[]->name
}`);

const allTags = [...new Set(posts.flatMap(post => post.tags || []))];

export async function getStaticPaths() {
  return allTags.map(tag => ({
    params: { tag },
  }));
}

// Get posts related to a specific tag
const { tag } = Astro.params;

const filteredPosts = await sanityClient.fetch(
  `*[_type == "post" && $tag in tags[]->name]{
    title,
    slug,
    mainImage,
    "tags": tags[]->name
  }`,
  { tag }
);

console.log(filteredPosts);
---
<Layout>
    <h1 class="text-2xl font-bold">Posts for {tag}</h1>

{filteredPosts.length > 0 ? (
  filteredPosts.map(post => (
    <div class="border p-4 my-2">
      <img src={post.mainImage} alt={post.title} class="w-full h-40 object-cover rounded-md"/>
      <h2 class="text-xl font-semibold mt-2">
        <a href={`/posts/${post.slug}`} class="text-blue-500 hover:underline">{post.title}</a>
      </h2>
    </div>
  ))
) : (
  <p>No posts found for this tag.</p>
)}
</Layout>