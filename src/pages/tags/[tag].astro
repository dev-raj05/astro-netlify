---
import { sanityClient } from "sanity:client";
import Layout from "../../layouts/Layout.astro";
import Card from "../../components/Card.astro";
import {unSlugify} from '../../lib/Slugify'

const posts = await sanityClient.fetch(`*[_type == "post"]{
  "tags": tags[]
}`);

const allTags = [...new Set(posts.flatMap(post => post.tags || []))];

export async function getStaticPaths() {
  return allTags.map(tag => ({
    params: { tag },
  }));
}

// Get posts related to a specific tag
const { tag } = Astro.params;

const filteredPosts = await sanityClient.fetch(
  `*[_type == "post" && $tag in tags[]]{
    title,
    slug,
    "mainImage": coalesce(mainImage.asset->url, ""),
    tags
  }`,
  { tag: `${unSlugify(tag)}` }
);

console.log(tag);

console.log(filteredPosts);
---
<Layout>
    <h1 class="text-2xl font-bold">Posts for {tag}</h1>
    {filteredPosts.length  > 0 ? (<div class="mb-4 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-2">
      {filteredPosts.map((post) => <Card post={post} />)}
    </div>) : <p>No post available related to this tag</p> }
    
</Layout>