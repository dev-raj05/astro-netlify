---
import { sanityClient } from "sanity:client";
import Layout from "../layouts/Layout.astro";
import {SearchfilterPosts} from '../lib/SearchFilter'


const posts = await sanityClient.fetch(`*[_type == "post"]{
  title,
  body,
  tags,
  "slug": slug.current
}`);
const currentUrl = new URL(Astro.request.url);
const searchQuery = currentUrl.searchParams.get('q') || '';
const filteredPosts = SearchfilterPosts(posts, searchQuery);
// console.log(filteredPosts);

---
<Layout>
    
    <form>
        <input type="text" name="q" placeholder="Search posts..." value={searchQuery} />
        <button type="submit">Search</button>
    </form>
