---
import {formatDate} from '../lib/Formatdate'
const { post } = Astro.props;
---

<div class="card overflow-hidden rounded-xl  bg-base-100 shadow-xl transition-transform duration-500 hover:-translate-y-1 hover:scale-105">
  <a href={`/post/${post.slug}`} class="block lg:flex">
    {/* Bigger Image Section */}
    <div class="lg:w-2/3">
      <img
        class="w-full h-full object-cover"
        src={post.mainImage}
        alt={post.alt}
      />
    </div>

    {/* Smaller Content Section */}
    <div class="card-body flex flex-col justify-between p-6 lg:w-1/3">
      {/* Tags */}
      <div class="flex flex-col flex-wrap gap-2 text-xs">
          <div class="flex flex-wrap gap-2 text-xs">

            {post.tags.map((tag) => (
              <span
              
              class="badge badge-outline border border-black px-3 py-1"
              >
            {tag}
          </span>
        ))}
        </div>
        
      <!-- <p class="text-xs text-gray-500">{post.publishedAt}</p> -->
      <p class="text-xs text-gray-500">{formatDate(post.publishedAt)}</p>
      </div>

      {/* Date */}

      {/* Title */}
      <h3 class="card-title text-lg font-semibold">{post.title}</h3>

      {/* Description */}
      <p class="text-sm text-gray-600">{post.description}</p>
    </div>
  </a>
</div>
