<section class="relative w-full min-h-[300px] py-16 flex flex-col items-center justify-center text-center">
  <!-- Grid Background -->
  <!-- background-color: rgb(243, 243, 243); -->
  <div
    class="absolute inset-0"
    style="
      /* Two perpendicular gradients for the grid lines */
      background-image:
        linear-gradient(to right, #aba5a5 1px, transparent 1px),
        linear-gradient(to bottom, #aba5a5 1px, transparent 1px);
      background-repeat: repeat;
      /* Size for 5 columns x 2 rows */
      background-size: 20% 50%;
      /* Shift the grid so it doesn't start at the exact left/right edges */
      background-position: 10% 0;
    "
  ></div>

  <!-- Content (above the background) -->
  <div class="relative z-10 max-w-screen-lg mx-auto px-4">
    <h1 class="text-3xl md:text-5xl font-semibold text-black leading-snug mb-3">
      Check what Booleanmaths 
      <span class="block">
        has to offer!
      </span>
    </h1>
    <a href="https://booleanmaths.com/" target="_blank" rel="noopener noreferrer">
      <button
        class="px-6 py-3 border border-black text-black font-medium rounded-lg
               hover:bg-black hover:text-white transition-colors"
      >
        Go to Booleanmaths
      </button>
    </a>
  </div>
</section>
